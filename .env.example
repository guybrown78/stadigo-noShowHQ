# Local Docker Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://noshowhq:noshowhq@localhost:5433/noshowhq?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Set to true on Vercel / behind a proxy
AUTH_TRUST_HOST="true"

# Optional later (Vercel Blob — not used in foundation)
# BLOB_READ_WRITE_TOKEN=""

# Optional later (Neon production — use pooled URL for app, direct for migrations)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
