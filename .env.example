# Local Docker Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://noshowhq:noshowhq@localhost:5433/noshowhq?schema=public"
DIRECT_URL="postgresql://noshowhq:noshowhq@localhost:5433/noshowhq?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Set to true on Vercel / behind a proxy
AUTH_TRUST_HOST="true"

# Optional: seed a SUPER_ADMIN during `npm run build` (used on Vercel)
# SUPER_ADMIN_EMAIL="you@example.com"
# SUPER_ADMIN_PASSWORD="choose-a-strong-password"
# SUPER_ADMIN_FIRST_NAME="Platform"
# SUPER_ADMIN_LAST_NAME="Owner"

# Optional later (Vercel Blob — not used in foundation)
# BLOB_READ_WRITE_TOKEN=""

# Production (Neon on Vercel):
# DATABASE_URL = pooled connection (host contains -pooler, add pgbouncer=true if missing)
# DIRECT_URL   = unpooled / "direct" connection (required for Prisma migrations)
# AUTH_URL     = https://your-app.vercel.app
