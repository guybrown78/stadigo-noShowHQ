generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum EventStatus {
  PLANNED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  eventTypes    EventType[]
  eventSubtypes EventSubtype[]
  venues        Venue[]
  events        Event[]
  eventImports  EventImport[]
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  firstName           String
  lastName            String
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String
  role                Role
  tenantId            String?
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  eventsCreated           Event[]              @relation("EventCreatedBy")
  eventsUpdated           Event[]              @relation("EventUpdatedBy")
  eventsDeleted           Event[]              @relation("EventDeletedBy")
  eventImportsUploaded    EventImport[]        @relation("EventImportUploadedBy")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EventType {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  code      String
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  subtypes  EventSubtype[]
  events    Event[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model EventSubtype {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  name        String
  code        String
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  events      Event[]

  @@unique([id, eventTypeId])
  @@unique([tenantId, eventTypeId, code])
  @@index([tenantId, eventTypeId, active])
}

model Venue {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name           String
  nameNormalized String
  addressLine1   String?
  townCity       String?
  postcode       String?
  timezone       String   @default("Europe/London")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  events              Event[]
  importVenuesMatched EventImportVenue[] @relation("EventImportVenueMatched")
  importVenuesCreated EventImportVenue[] @relation("EventImportVenueCreated")

  @@unique([id, tenantId])
  @@unique([tenantId, nameNormalized])
  @@index([tenantId, active])
  @@index([tenantId, name])
}

model Event {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reference        String?
  name             String
  eventTypeId      String
  eventType        EventType    @relation(fields: [eventTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  eventSubtypeId   String
  eventSubtype     EventSubtype @relation(fields: [eventSubtypeId, eventTypeId], references: [id, eventTypeId], onDelete: Restrict)
  venueId          String
  venue            Venue        @relation(fields: [venueId, tenantId], references: [id, tenantId], onDelete: Restrict)
  eventDate        DateTime     @db.Date
  briefingTime     String?
  startTime        String?
  endTime          String?
  endsNextDay      Boolean      @default(false)
  staffRequired    Int
  warningFillRate  Int          @default(90)
  criticalFillRate Int          @default(85)
  status           EventStatus  @default(PLANNED)
  notes            String?      @db.VarChar(2000)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdById      String
  createdBy        User         @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById      String
  updatedBy        User         @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedAt        DateTime?
  deletedById      String?
  deletedBy        User?        @relation("EventDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  importRows       EventImportRow[]

  @@unique([tenantId, reference])
  @@index([tenantId, deletedAt, eventDate])
  @@index([tenantId, status])
  @@index([tenantId, eventTypeId])
  @@index([tenantId, name])
  @@index([tenantId, reference])
}

enum EventImportStatus {
  UPLOADED
  VALIDATION_FAILED
  AWAITING_VENUE_CONFIRMATION
  VENUES_CONFIRMED
  AWAITING_EVENT_CONFIRMATION
  COMPLETED
  FAILED
  CANCELLED
}

enum EventImportRowStatus {
  VALID
  INVALID
  IGNORED
}

enum EventImportVenueOutcome {
  MATCHED
  NEW
  AMBIGUOUS
}

model EventImport {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedById       String
  uploadedBy         User              @relation("EventImportUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  originalFileName   String
  fileHash           String
  totalRows          Int               @default(0)
  validRows          Int               @default(0)
  invalidRows        Int               @default(0)
  ignoredRows        Int               @default(0)
  matchedVenueCount  Int               @default(0)
  newVenueCount      Int               @default(0)
  createdVenueCount  Int               @default(0)
  createdEventCount  Int               @default(0)
  duplicateEventCount Int              @default(0)
  status             EventImportStatus @default(UPLOADED)
  failureReason      String?
  uploadedAt         DateTime          @default(now())
  venueConfirmedAt   DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  cancelledAt        DateTime?
  rows               EventImportRow[]
  venues             EventImportVenue[]

  @@index([tenantId, uploadedAt])
  @@index([tenantId, status])
  @@index([tenantId, fileHash])
  @@index([uploadedById])
}

model EventImportRow {
  id               String              @id @default(cuid())
  importId         String
  import           EventImport         @relation(fields: [importId], references: [id], onDelete: Cascade)
  tenantId         String
  sourceRowNumber  Int
  raw              Json
  normalized       Json?
  fieldErrors      Json?
  eventTypeId      String?
  eventSubtypeId   String?
  venueKey         String?
  createdEventId   String?
  createdEvent     Event?              @relation(fields: [createdEventId], references: [id], onDelete: SetNull)
  status           EventImportRowStatus

  @@unique([importId, sourceRowNumber])
  @@index([importId, status])
  @@index([tenantId])
}

model EventImportVenue {
  id               String                   @id @default(cuid())
  importId         String
  import           EventImport              @relation(fields: [importId], references: [id], onDelete: Cascade)
  tenantId         String
  nameNormalized   String
  importedName     String
  addressLine1     String?
  townCity         String?
  postcode         String?
  outcome          EventImportVenueOutcome
  matchedVenueId   String?
  matchedVenue     Venue?                   @relation("EventImportVenueMatched", fields: [matchedVenueId], references: [id], onDelete: Restrict)
  createdVenueId   String?
  createdVenue     Venue?                   @relation("EventImportVenueCreated", fields: [createdVenueId], references: [id], onDelete: Restrict)
  inactiveMatch    Boolean                  @default(false)
  eventRowCount    Int

  @@unique([importId, nameNormalized])
  @@index([tenantId])
}
